<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F2"
    tools:context=".ui.MainActivity">

    <pl.navilas.finder.ui.PageSwipeZone
        android:id="@+id/toolbarSwipeZone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B5E20"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:title="@string/app_name" />
    </pl.navilas.finder.ui.PageSwipeZone>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/pageIndicatorBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarSwipeZone" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarSwipeZone" />

    <pl.navilas.finder.ui.PageSwipeZone
        android:id="@+id/pageIndicatorBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:minHeight="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btnPagePrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/page_prev"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_left" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/pageLabels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="#556655"
                    tools:text="WYSZUKIWANIE  ·  MAPA  ·  LISTA" />

                <LinearLayout
                    android:id="@+id/pageDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot0"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/page_dot_active" />

                    <View
                        android:id="@+id/dot1"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/page_dot_inactive" />

                    <View
                        android:id="@+id/dot2"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/page_dot_inactive" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPageNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/page_next"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </pl.navilas.finder.ui.PageSwipeZone>

</androidx.constraintlayout.widget.ConstraintLayout>
