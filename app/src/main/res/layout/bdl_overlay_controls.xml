<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <CheckBox
        android:id="@+id/overlayEnable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bdl_overlay_enable" />

    <CheckBox
        android:id="@+id/overlayGroupView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bdl_overlay_group_view" />

    <CheckBox
        android:id="@+id/overlayGroupOther"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bdl_overlay_group_other" />

    <CheckBox
        android:id="@+id/overlayGroupWater"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bdl_overlay_group_water" />

    <CheckBox
        android:id="@+id/overlayGroupPlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bdl_overlay_group_play" />

    <CheckBox
        android:id="@+id/overlayGroupLodging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bdl_overlay_group_lodging" />

    <TextView
        android:id="@+id/overlayFullHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingTop="2dp"
        android:text="@string/bdl_overlay_full_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <TextView
        android:id="@+id/overlayLegend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingTop="4dp"
        android:text="@string/bdl_overlay_legend"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <CheckBox
        android:id="@+id/overlayEntryBans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/entry_ban_toggle" />

    <TextView
        android:id="@+id/overlayEntryBanHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingTop="2dp"
        android:text="@string/entry_ban_hint"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <TextView
        android:id="@+id/overlayEntryBanPackStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingTop="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownloadEntryBans"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/entry_ban_download" />
</LinearLayout>
