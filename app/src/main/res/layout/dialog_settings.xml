<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_label"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/themeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_system" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/themeAmbient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_ambient" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/themeDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_day" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/themeNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_night" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_night_map_label"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <RadioGroup
            android:id="@+id/nightMapGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/nightMapLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_night_map_light" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/nightMapDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_night_map_dark" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_startup_label"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <RadioGroup
            android:id="@+id/startupGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/startupRemember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_startup_remember" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/startupSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_startup_search" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/startupBrowse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_startup_browse" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/keepScreenOnTracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_keep_screen_on" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOsmAndProfiles"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_osmand_profiles" />

        <LinearLayout
            android:id="@+id/updateChannelSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_update_channel_label"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_update_channel_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <RadioGroup
                android:id="@+id/updateChannelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/updateChannelNightly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_update_channel_nightly" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/updateChannelBeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_update_channel_beta" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/updateChannelFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_update_channel_final" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
