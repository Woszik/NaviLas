<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <pl.navilas.finder.ui.NestedScrollableHost
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/mapSearchHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.92"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/map_search_pin_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface" />
    </pl.navilas.finder.ui.NestedScrollableHost>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <pl.navilas.finder.ui.MapPagerTouchBridge
            android:id="@+id/mapTouchBridge"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <org.maplibre.android.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/mapZoomScale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="#CC212121"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="z —"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="#FFFFFF"
                tools:text="z 11.2" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/btnMapPlaceFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:contentDescription="@string/map_filter_fab"
                android:text="@string/map_filter_fab"
                app:icon="@drawable/ic_filter_list"
                app:iconPadding="8dp"
                app:iconTint="?attr/colorOnSecondaryContainer"
                app:backgroundTint="?attr/colorSecondaryContainer" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMapTrackLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="68dp"
                android:contentDescription="@string/map_tracking_cd"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_media_play"
                app:tint="?attr/colorOnSecondaryContainer"
                app:backgroundTint="?attr/colorSecondaryContainer" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMapMyLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:contentDescription="@string/map_my_location_cd"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_menu_mylocation"
                app:tint="?attr/colorOnSecondaryContainer"
                app:backgroundTint="?attr/colorSecondaryContainer" />
        </pl.navilas.finder.ui.MapPagerTouchBridge>

        <pl.navilas.finder.ui.NestedScrollableHost
            android:id="@+id/mapBottomSwipeHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/poiCardInclude"
                    layout="@layout/poi_card" />
            </FrameLayout>
        </pl.navilas.finder.ui.NestedScrollableHost>
    </FrameLayout>
</LinearLayout>
