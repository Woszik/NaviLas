<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <pl.navilas.finder.ui.NestedScrollableHost
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/mapSearchHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CCFFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/map_search_pin_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#333333" />
    </pl.navilas.finder.ui.NestedScrollableHost>

    <pl.navilas.finder.ui.MapPagerTouchBridge
        android:id="@+id/mapTouchBridge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mapZoomScale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="#CC212121"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="z —"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#FFFFFF"
            tools:text="z 11.2" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnMapPlaceFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:contentDescription="@string/map_filter_fab"
            android:text="@string/map_filter_fab"
            app:icon="@drawable/ic_filter_list"
            app:iconPadding="8dp"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMapTrackLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="68dp"
            android:contentDescription="@string/map_tracking_cd"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/ic_media_play"
            app:tint="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMapMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:contentDescription="@string/map_my_location_cd"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/ic_menu_mylocation"
            app:tint="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer" />
    </pl.navilas.finder.ui.MapPagerTouchBridge>

    <pl.navilas.finder.ui.NestedScrollableHost
        android:id="@+id/mapBottomSwipeHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/poiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/cardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            tools:text="Miejsce odpoczynku „Radoszowy”" />

                        <ImageButton
                            android:id="@+id/btnSaveCard"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/btn_save"
                            android:padding="8dp"
                            android:src="@android:drawable/btn_star_big_off"
                            app:tint="#795548" />

                        <ImageButton
                            android:id="@+id/btnCloseCard"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/close_poi_card"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#555555" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cardDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="#1B5E20"
                        tools:text="13,0 km" />

                    <TextView
                        android:id="@+id/cardFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="Wiata · Palenisko · Ławostoły" />

                    <TextView
                        android:id="@+id/cardZanocuj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="#1B5E20"
                        tools:text="🌲 W strefie „Zanocuj w lesie”" />

                    <TextView
                        android:id="@+id/cardSavedMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="#795548"
                        android:visibility="gone"
                        tools:text="Kategoria: Ulubione · Komentarz: …"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cardEditSaved"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_edit_saved"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cardDetails"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_details" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cardNavigate"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_navigate" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </pl.navilas.finder.ui.NestedScrollableHost>
</LinearLayout>
